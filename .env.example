# ============================================================================
# Pulse configuration (example). Copy to .env and edit. NEVER commit .env.
# Every value here is safe/non-secret by default. Secrets must be generated,
# never hardcoded. See docs/SELF_HOSTING.md and docs/CLOUD_MODE.md.
# ============================================================================

# ---- Deployment mode: "local" (self-hosted) or "cloud" -------------------
PULSE_MODE=local

# The dashboard build reads the same distinction to decide whether to ship the
# public marketing landing page at all. In a self-hosted build "/" redirects
# straight to /app (signed in) or /login (not), and the landing/marketing
# chunks are never emitted. Any ONE of these turns that on; PULSE_MODE=local
# already does, so these only matter if you build the SPA outside compose.
IS_SELF_HOSTED=true
APP_MODE=self_hosted

# ---- Cloud connection (only used when PULSE_MODE=cloud) -------------------
PULSE_API_URL=https://pulse.frix.me
PULSE_SERVER_ID=
PULSE_ENROLLMENT_TOKEN=

# ---- Self-hosted dashboard ------------------------------------------------
DASHBOARD_DOMAIN=
# Port the dashboard is exposed on. The installer picks a free port if this
# is empty; never assume 3000/9090/9100 are available.
DASHBOARD_PORT=

# ---- Control-plane database (PostgreSQL) ----------------------------------
# The installer provisions an ISOLATED Postgres for Pulse; it never reuses or
# touches an existing application database.
DATABASE_URL=postgres://pulse:CHANGE_ME@pulse-postgres:5432/pulse?sslmode=disable

# ---- Metrics backend (Prometheus-compatible) ------------------------------
METRICS_URL=http://pulse-prometheus:9090

# ---- Auth / sessions ------------------------------------------------------
# Generate with: openssl rand -hex 32   (installer does this automatically)
PULSE_SESSION_SECRET=
PULSE_JWT_SIGNING_KEY=

# ---- Initial administrator ------------------------------------------------
# Two ways to provision the first account, pick ONE:
#
#   1. Set both variables below. The owner is seeded on first start and the
#      /setup wizard never opens. The password must be at least 12 characters;
#      a weak one is refused rather than silently accepted.
#   2. Leave both EMPTY. On first boot the dashboard opens the onboarding
#      wizard at /setup, which creates the account in the browser. The endpoint
#      closes permanently once any account exists.
#
# Passwords are hashed with PBKDF2-HMAC-SHA256 (210k iterations, per-password
# salt) and are never logged. Never commit a real value here.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to false to disable the /setup wizard entirely and require ADMIN_EMAIL /
# ADMIN_PASSWORD. Only meaningful before the first account exists.
PULSE_SETUP_WIZARD=true

# ---- Metrics retention ----------------------------------------------------
# Conservative defaults for small VPSs. Never consume the whole disk.
METRICS_RETENTION=7d
METRICS_MAX_DISK=2GB

# ---- Resource limits for the monitoring stack -----------------------------
MONITORING_CPU_LIMIT=1.0
MONITORING_MEMORY_LIMIT=512M

# ---- Feature flags (safest value is the default) --------------------------
ENABLE_CONFIG_MUTATION=false
ENABLE_AUTO_TLS=false
ENABLE_REMOTE_ACTIONS=false
ENABLE_AUTO_UPDATE=false

# The browser SSH console (docs/SSH_CONSOLE.md). This is the ONLY feature that
# can change a server: it opens a real SSH connection from the API using
# credentials the operator types per session. The agent is not involved and
# stays read-only. Owners and admins only — viewers never get a shell.
#
# It is ON by default and needs no configuration. Set this to false to remove
# the terminal entirely.
# PULSE_SSH_CONSOLE=true

# ---- Host discovery -------------------------------------------------------
# Where the HOST filesystem is visible to a containerised agent. The compose
# files mount / at /host read-only; a host-installed agent leaves this empty.
# Discovery reads nginx/apache/caddy/traefik/haproxy config, /etc/hosts, TLS
# certs and disk usage under this prefix and NEVER writes to it.
PULSE_ROOTFS=/host

# Attributing a listening socket to the process behind it (the "ss -tulpn"
# correlation) means reading /proc/<pid>/fd, which needs either root or
# CAP_SYS_PTRACE. Without it, ports are still discovered — they are just
# reported as "unattributed" in the inventory instead of being tied to a
# service or container.
#
# For a HOST-INSTALLED agent running as an unprivileged user, setting this to
# true lets discovery retry exactly two READ-ONLY commands through `sudo -n`:
# "systemctl list-units ..." and "ss -tulpnH". Both are inspection-only, both
# use a fixed argument vector, and -n means a missing rule fails instantly
# rather than prompting. Install the matching least-privilege rule from
# infrastructure/pulse-discovery.sudoers. The containerised agent does not need
# this and should leave it false.
PULSE_USE_SUDO=false

# ---- Logging --------------------------------------------------------------
PULSE_LOG_LEVEL=info
PULSE_LOG_FORMAT=json
